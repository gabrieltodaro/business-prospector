{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "business-prospector": {
      "type": "stdio",
      "command": "./bin/business-prospector-mcp",
      "args": [],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "BUSINESS_PROSPECTOR_DATA_DIR": "${PLUGIN_DATA}",
        "BUSINESS_PROSPECTOR_CONFIG": "${PLUGIN_ROOT}/config/default.json"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.79"]
    }
  }
}
